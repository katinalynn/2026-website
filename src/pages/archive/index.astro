---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('archive')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Archive">
  <div class="page-header">
    <h1>Archive</h1>
    <p class="page-subtitle">Posts from katinarogers.com, 2011–2022</p>
  </div>

  {[...byYear].map(([year, yearPosts]) => (
    <section class="archive-year">
      <h2>{year}</h2>
      <ul class="archive-list">
        {yearPosts.map(post => (
          <li>
            <time class="blog-post-date" datetime={post.data.date.toISOString().slice(0, 10)}>
              {fmt(post.data.date)}
            </time>
            <a href={`/archive/${post.slug}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
